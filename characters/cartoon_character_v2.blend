bpy.ops.render.render(
    animation=True
)


# ============================================================
# COUNT FRAMES
# ============================================================

frames = list(
    FRAME_DIR.glob(
        "frame_*.png"
    )
)


print("")
print(
    "PNG frames created:",
    len(frames)
)


if len(frames) == 0:

    raise RuntimeError(
        "No animation frames were rendered."
    )


# ============================================================
# CREATE MP4
# ============================================================

if FFMPEG is not None:

    print("")
    print("Creating MP4 with FFmpeg...")
    print("")


    command = [

        FFMPEG,

        "-y",

        "-framerate",
        "24",

        "-start_number",
        "1",

        "-i",
        str(
            FRAME_DIR
            / "frame_%04d.png"
        ),

        "-c:v",
        "libx264",

        "-preset",
        "medium",

        "-crf",
        "18",

        "-pix_fmt",
        "yuv420p",

        "-movflags",
        "+faststart",

        str(OUTPUT_VIDEO)
    ]


    result = subprocess.run(
        command,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True
    )


    print(
        result.stdout
    )


    if result.returncode != 0:

        raise RuntimeError(
            "FFmpeg failed to create video."
        )


